	<parameter name="estacion" class="java.lang.Integer"/>
	<queryString>
		<![CDATA[SELECT station, nombre, direccion,
 date as fecha, ROUND(AVG(tempout),2) as temp_promedio
FROM mediciones, estacion
WHERE numero = station 
AND station =  $P{estacion} 
GROUP BY date]]>
	</queryString>
